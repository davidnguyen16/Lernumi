FROM php:8.3-fpm-bookworm AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev libzip-dev \
    && docker-php-ext-install -j$(nproc) pdo_pgsql zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && printf '%s\n' \
        'memory_limit=128M' \
        'upload_max_filesize=25M' \
        'post_max_size=32M' \
        'expose_php=Off' \
        'opcache.memory_consumption=32' \
        'opcache.validate_timestamps=0' \
        > "$PHP_INI_DIR/conf.d/zz-lernumi.ini" \
    && printf '%s\n' \
        '[www]' \
        'pm=ondemand' \
        'pm.max_children=1' \
        'pm.process_idle_timeout=10s' \
        'pm.max_requests=200' \
        > /usr/local/etc/php-fpm.d/zz-lernumi.conf


FROM base AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1

COPY . .

RUN mkdir -p \
        bootstrap/cache \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/cache/locks \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
    && composer install \
        --no-dev \
        --prefer-dist \
        --no-interaction \
        --optimize-autoloader \
    && composer check-platform-reqs --no-dev


FROM base AS production

ENV APP_ENV=production APP_DEBUG=false

COPY --from=build --chown=www-data:www-data \
    /var/www/html /var/www/html

USER www-data

EXPOSE 9000

CMD ["php-fpm", "-F"]